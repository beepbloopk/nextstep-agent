# Pick ONE provider. If GEMINI_API_KEY is set, Gemini is used (free tier, Google AI Studio).
GEMINI_API_KEY=
# Optional. Model strings change over time, so they are read from env. Default: gemini-3.8-flash
# (gemini-2.5-* is no longer available to new keys). Faster, weaker option: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# Optional. Gemini 3 thinking level: low (default) | medium | high
GEMINI_THINKING_LEVEL=low

# Alternative provider (paid). Used when no Gemini key is set, or when NEXTSTEP_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional. Default: claude-haiku-4-5
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional. Force a provider: gemini | anthropic
NEXTSTEP_PROVIDER=

# Optional. Sent as X-Candidate-Id when fetching the shared scenarios from the NextStep mock API.
NEXTSTEP_CANDIDATE_ID=you@example.com

# Optional. User timezone for calculateTime(). Default Asia/Kolkata.
NEXTSTEP_TZ=Asia/Kolkata

# Optional. Hard cap on tool calls per agent run. Default 10.
NEXTSTEP_MAX_TOOL_CALLS=10

# Optional. Where runtime state (append-only logs, keys, outbox) is written. Default ./data
NEXTSTEP_DATA_DIR=./data
