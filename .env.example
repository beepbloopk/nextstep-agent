# Required for talking to the real AI. Free key: aistudio.google.com -> Get API key.
GEMINI_API_KEY=

# Optional. One model or a comma-separated fallback chain (used when a model's free daily quota runs out).
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Optional. Gemini 3 thinking level: low (default) | medium | high
GEMINI_THINKING_LEVEL=low

# Optional. Sent as X-Candidate-Id when fetching the shared scenarios from the NextStep mock API.
NEXTSTEP_CANDIDATE_ID=you@example.com

# Optional. User timezone for calculateTime. Default Asia/Kolkata.
NEXTSTEP_TZ=Asia/Kolkata

# Optional. Maximum tool calls per agent run. Default 10.
NEXTSTEP_MAX_TOOL_CALLS=10

# Optional. Where the logs, keys and outbox are written. Default ./data
NEXTSTEP_DATA_DIR=./data
